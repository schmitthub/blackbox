POSTGRES_PASSWORD=change-me

# Auth0. `scripts/setup.sh --auth0` reads these and creates the resources.

# Tenant domain, for example your-tenant.us.auth0.com. Leave it empty to use
# the tenant the auth0 CLI is logged in to; setup then writes it here.
AUTH0_DOMAIN=
# Identifier of the API: the `aud` of its tokens. It cannot change later.
AUTH0_AUDIENCE=urn:blackbox:api
AUTH0_API_NAME="Blackbox API"
AUTH0_MCP_NAME="Blackbox MCP"
# Comma-separated redirect URLs of the MCP client.
AUTH0_MCP_CALLBACKS=http://localhost:8081/callback
# Access token lifetime, seconds.
AUTH0_TOKEN_LIFETIME=86400
# Written by setup.
AUTH0_MCP_CLIENT_ID=
